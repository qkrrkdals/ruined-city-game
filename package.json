{
  "name": "ruined-city-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run bp:build",
    "preview": "vite preview --port 4173 --strictPort",
    "check": "node scripts/check.cjs",
    "bp:dev": "npm run bp:fonts && vite --config byeongpung/vite.config.js",
    "bp:build": "npm run bp:fonts && vite build --config byeongpung/vite.config.js && node byeongpung/scripts/pack.mjs",
    "bp:check": "node byeongpung/scripts/check.cjs",
    "bp:fonts": "node byeongpung/scripts/fonts.mjs"
  },
  "dependencies": {
    "@fontsource/gaegu": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@expo-google-fonts/east-sea-dokdo": "^0.4.1",
    "@expo-google-fonts/song-myung": "^0.4.2",
    "@expo-google-fonts/yeon-sung": "^0.4.1",
    "subset-font": "^2.9.0",
    "vite": "^8.3.5"
  }
}
